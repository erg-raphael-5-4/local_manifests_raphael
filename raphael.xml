<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for xiaomi/raphael (Snapdragon 855, msmnile).

  The device sets BOARD_USES_QCOM_HARDWARE := true (in
  device/xiaomi/sm8150-common/BoardConfigCommon.mk), which routes Make-side
  module resolution to hardware/qcom-caf/sm8150/*. Soong (Android.bp) has no
  equivalent guard, so any generic hardware/qcom/* trees that get synced
  would collide with the CAF/sm8150 versions of the same module names.

  This manifest does two jobs:
   1. <remove-project> the conflicting / wrong-SoC trees so they don't land
      on disk.
   2. Override LineageOS upstream sources with our private forks at
      erg-raphael-5-4 for the three trees where we maintain device-specific
      patches that would otherwise be wiped on `repo sync`.

  Cloning the private forks requires a credential. Set up ~/.netrc or
  configure git URL rewrites (git config global url.insteadOf) before
  the first sync.
-->
<manifest>

  <!-- Remote for our private forks -->
  <remote name="erg-raphael" fetch="https://github.com/" />

  <!-- 1. Remove projects we want gone entirely -->

  <!-- Generic audio HAL: collides with hardware/qcom-caf/sm8150/audio. -->

  <!-- Wrong-SoC trees. sdm845 = SD845, sm7250 = SD765 — not raphael. -->
  <remove-project name="LineageOS/android_hardware_qcom_sdm845_display" optional="true" />
  <remove-project name="LineageOS/android_hardware_qcom_sdm845_gps" optional="true" />
  <remove-project name="LineageOS/android_hardware_qcom_sm7250_display" optional="true" />
  <remove-project name="LineageOS/android_hardware_qcom_sm7250_gps" optional="true" />

  <!-- Right SoC but redundant with hardware/qcom-caf/sm8150/. -->
  <remove-project name="LineageOS/android_hardware_qcom_sm8150_display" optional="true" />
  <remove-project name="LineageOS/android_hardware_qcom_sm8150_gps" optional="true" />

  <!-- 2. Override upstream sources with our private forks. -->

  <!-- sm8150 display: THE LIVE DISPLAY HAL. Our fork carries an sm8150
       sde-drm backend built against the 5.4 kernel, the offline-rotator
       disable and GPU rotation path (changes.md section 38), and the
       display_headers library the media tree builds against. -->
  <remove-project name="LineageOS/android_hardware_qcom_display" optional="true"
                  path="hardware/qcom-caf/sm8150/display" />
  <project name="erg-raphael-5-4/android_hardware_qcom_display_sm8150"
           path="hardware/qcom-caf/sm8150/display"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8150-raphael" />

  <!-- sm8150 media: heavily patched (vidc_v4l2_compat.h, c2d2.h symlink,
       msm_vidc_vui_display_info_payload member rename, local include_dirs
       to find media/msm_*.h kernel UAPI). Also carries c2-venc, the in-tree
       Codec2 AVC/HEVC encoders that replace the QTI prebuilts as default
       (changes.md sections 43-50). -->
  <remove-project name="LineageOS/android_hardware_qcom_media" optional="true"
                  path="hardware/qcom-caf/sm8150/media" />
  <project name="erg-raphael-5-4/android_hardware_qcom_media_sm8150"
           path="hardware/qcom-caf/sm8150/media"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8150-raphael" />

  <!-- sm8350 audio: our fork disables the duplicate audio HAL modules
       (sm8150 audio HAL wins on this build). -->
  <remove-project name="LineageOS/android_hardware_qcom_audio" optional="true"
                  path="hardware/qcom-caf/sm8350/audio" />
  <project name="erg-raphael-5-4/android_hardware_qcom_audio_sm8350"
           path="hardware/qcom-caf/sm8350/audio"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8350-raphael" />

  <!-- sm8350 display: no longer the live display HAL (the sm8150 tree above
       is, since changes.md section 38). Kept pinned so the fork's
       DisplayBuiltIn::Init() panel-feature fix is not lost and the tree
       stays consistent with the blob set that was in use before. -->
  <remove-project name="LineageOS/android_hardware_qcom_display" optional="true"
                  path="hardware/qcom-caf/sm8350/display" />
  <project name="erg-raphael-5-4/android_hardware_qcom_display_sm8350"
           path="hardware/qcom-caf/sm8350/display"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8350-raphael" />

  <!-- raphael kernel - our fork (Linux 5.4 + KernelSU-Next hooks +
       TFA9874 DAVI path enabled + LOCALVERSION suffix -qgki_ergdev +
       tfa_tx_hostless dailink macro fix). Not in the upstream manifest -
       lineage.dependencies normally pulls it via roomservice; we override
       directly to our fork. -->
  <project name="erg-raphael-5-4/android_kernel_xiaomi_sm8150"
           path="kernel/xiaomi/sm8150"
           remote="erg-raphael"
           revision="derp-17" />

  <!-- frameworks/opt/net/wifi is NOT overridden on the Android 17 tree. Our
       fork (WifiTrackerLib SAE/OWE transition-mode fix) is Android 16 based;
       re-evaluate against AOSP 17 and cherry-pick if the bug is still there. -->

  <!-- Device trees + hardware/xiaomi - our private forks. Not in the
       upstream manifest; roomservice/lineage.dependencies would otherwise
       pull the public LineageOS trees and lose our patches (screen-off FOD
       config + namespace + libgf_hal pin, raphael UDFPS + namespace fixes,
       and the raphael Session.cpp NULL guard). Declared here so repo owns
       them and roomservice leaves them alone. -->
  <!-- raphael device tree. Originally taken from DUCKS-QCM-5-4 because
       erg-raphael-5-4/android_device_xiaomi_raphael used to hold a second fork of
       sm8150-common (715 commits all prefixed "sm8150-common:", with no
       AndroidProducts.mk / lineage_raphael.mk / BoardConfig.mk / device.mk), which
       carried no product definition. That repo has since been force-pushed with the
       real DUCKS-based tree, so it is now the canonical source. The superseded
       history is preserved in the bundle noted in changes.md.

       Carries motor/ (pop-up camera), tfa98xx/ and qdcm/, plus our in-call speaker
       backend mapping and the tfa98xx NULL/UAF fix. -->
  <project name="erg-raphael-5-4/android_device_xiaomi_raphael"
           path="device/xiaomi/raphael"
           remote="erg-raphael"
           revision="derp-17" />

  <!-- Proprietary blobs. Absent from the original manifest entirely; without
       these the build has no camera/audio/DSP/fingerprint firmware and cannot
       produce a flashable image. -->
  <project name="erg-raphael-5-4/proprietary_vendor_xiaomi_raphael"
           path="vendor/xiaomi/raphael"
           remote="erg-raphael"
           revision="lineage-23.2-raphael" />

  <project name="erg-raphael-5-4/proprietary_vendor_xiaomi_sm8150-common"
           path="vendor/xiaomi/sm8150-common"
           remote="erg-raphael"
           revision="derp-17" />

  <project name="erg-raphael-5-4/android_device_xiaomi_sm8150-common"
           path="device/xiaomi/sm8150-common"
           remote="erg-raphael"
           revision="derp-17" />

  <project name="erg-raphael-5-4/android_hardware_xiaomi"
           path="hardware/xiaomi"
           remote="erg-raphael"
           revision="derp-17" />

  <!-- sm8150 audio HAL. Upstream LineageOS crashes with SIGSEGV on ordinary
       playback and takes audioserver down with it: a PCM_PLAYBACK usecase can
       own no stream (speaker-protection calibration builds one from a NULL
       adev->primary_output) and the app-type update dereferenced it blindly.
       See changes.md section 32.1. -->
  <remove-project name="LineageOS/android_hardware_qcom_audio" optional="true"
                  path="hardware/qcom-caf/sm8150/audio" />
  <project name="erg-raphael-5-4/android_hardware_qcom_audio_sm8150"
           path="hardware/qcom-caf/sm8150/audio"
           remote="erg-raphael"
           revision="lineage-23.2-caf-sm8150-raphael" />

</manifest>
